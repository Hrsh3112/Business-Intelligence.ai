# ── API & LLM Configuration ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Component Resolution: set to false to use real ml_engine & c3_engine
USE_MOCK_C1=false
USE_MOCK_C3=false
MOCK_SCENARIO=critical

# Timeout Budgets (seconds)
C1_TIMEOUT_S=10
C3_TIMEOUT_S=30
LLM_TIMEOUT_S=20

# Upload & Feedback
MAX_UPLOAD_MB=10
# Relative to the server's working directory, not the repo root. start.sh and
# start.ps1 launch uvicorn from backend/, so this lands at
# backend/feedback.jsonl — use an absolute path if you want it elsewhere.
# POST /feedback appends one JSON line per submission; nothing reads it back
# yet (see api/routes/feedback.py).
FEEDBACK_LOG_PATH=./feedback.jsonl

# Security: comma-separated origins allowed to call the API. Default is the
# local frontend only; set explicitly when deploying. "*" is accepted but is
# then a deliberate choice, not a default nobody revisited.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend Configuration ──────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SHOW_SCENARIO_SWITCHER=true
